# Copy to .env for `python -m atc_server.main` on the host.
# Docker Compose sets these itself; do not point Compose at this file (it may contain secrets).

# Shared secret the client must send (?token=...). Leave empty to disable auth (local dev only).
ATC_AUTH_TOKEN=

# redis://localhost:6379/0 when Redis is on the host. Compose uses redis://redis:6379/0.
ATC_REDIS_URL=redis://localhost:6379/0
ATC_ASR_URL=http://localhost:8101
ATC_TTS_URL=http://localhost:8102

# "echo" speaks the pilot's words back and skips the controller. "brain" is the ATC path.
ATC_REPLY_MODE=brain

# Altitude conformance. Compose's integration stack sets sustain to 0.
ATC_ALTITUDE_TOLERANCE_FT=200
ATC_DEVIATION_SUSTAIN_S=5

# Weather ingest is off until you set a METAR URL you have verified.
# TODO(verify): aviationweather.gov current path.
ATC_WEATHER_INGEST=false
ATC_WEATHER_METAR_URL=
ATC_WEATHER_ICAOS=

ATC_RADIO_FX=true
